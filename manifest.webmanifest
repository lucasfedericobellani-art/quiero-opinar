      "url": "/?source=pwa-shortcut&app=quieroopinar#opinar",
      "icons": [
        {
          "src": "/assets/pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Temas",
      "short_name": "Temas",
